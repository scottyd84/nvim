local function enable_transparency()
  vsh -c "cat /home/scott/.config/nvim/lua/plugins/colors.lua"
  im.api.set_hl(0, "Normal", { bg = "none" })
end

return {
  {
    "folke/tokyonight.nvim",
    config = function()
                        require("tokyonight").setup({
                                style = "night",
                                transparent = true,
                                styles = {
                                        sidebars = "transparent",
                                        floats = "transparent",
                                },
                        })
                        vim.cmd([[colorscheme tokyonight]])
                        enable_transparency()
                end,
        }
}
